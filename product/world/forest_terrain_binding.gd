extends RefCounted
## Retained Forest native resource bindings, copied from world.tscn.
## Recovery-mode export can omit GDExtension subresources from SceneState.
## Restore only omitted bindings, once and before the world enters the tree.
## The original authored scene, textures, vegetation and terrain data stay intact.

static func instantiate(source: PackedScene) -> Node3D:
	var world: Node3D = source.instantiate()
	var state := source.get_state()
	var missing := {"material": true, "assets": true}
	for i in range(state.get_node_count()):
		if str(state.get_node_path(i)) != "./Terrain3D":
			continue
		for j in range(state.get_node_property_count(i)):
			var property := str(state.get_node_property_name(i, j))
			if missing.has(property):
				missing[property] = state.get_node_property_value(i, j) == null
		break
	if missing.material or missing.assets:
		var authored := authored_resources()
		var terrain := world.get_node("Terrain3D")
		if missing.material:
			terrain.set("material", authored["Terrain3DMaterial_tlwt5"])
		if missing.assets:
			terrain.set("assets", authored["Terrain3DAssets_dwbse"])
	return world

